# backend/.env — copy this file to backend/.env and fill in values for your
# deployment. None of these are required to run the app locally; every one
# has a safe default so `uvicorn main:app --reload` just works out of the box.

# ---------------------------------------------------------------------------
# CORS (Milestone 4, Part H)
# ---------------------------------------------------------------------------
# Comma-separated list of allowed browser origins for your deployed
# frontend, e.g.:
#   FRONTEND_URL=https://mplads-ai.example.com,https://staging.mplads-ai.example.com
# Local dev origins (http://localhost:5173, http://127.0.0.1:5173) are
# always allowed in addition to whatever you set here, so this is safe to
# leave unset while developing.
FRONTEND_URL=

# ---------------------------------------------------------------------------
# Server port (optional)
# ---------------------------------------------------------------------------
# Only used if you run `python main.py` directly (some hosting platforms
# inject $PORT this way). Not needed if you run
# `uvicorn main:app --host 0.0.0.0 --port 8000` yourself.
PORT=8000

# ---------------------------------------------------------------------------
# Authentication (backend/auth.py)
# ---------------------------------------------------------------------------
# Secret used to sign login JWTs. If unset, the app falls back to an
# insecure development default and logs a warning on startup — fine for
# running this locally, NOT fine for deploying anywhere reachable by
# anyone else. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# Minutes a login session stays valid before the frontend must log in
# again. Defaults to 480 (8 hours) if unset.
JWT_EXPIRES_MINUTES=480

# ---------------------------------------------------------------------------
# Database (NOT required — see Part G of the milestone report)
# ---------------------------------------------------------------------------
# This application runs fully in-memory, seeded from data/sample_projects.csv
# at startup (or from a CSV you upload via POST /api/upload). No database is
# required for this phase, and MongoDB specifically is not part of this
# architecture at all — there is nothing here to wire a MONGODB_URI into.
# DATABASE_URL below is kept only as an optional, forward-looking hook for a
# future phase where a real datastore replaces the in-memory list; it is not
# read for anything today.
# DATABASE_URL=postgresql://user:CHANGE_ME@localhost:5432/mplads_ai
