# frontend/.env — copy this file to frontend/.env and fill in values for
# your deployment. Not required to run the app locally: if the backend
# isn't reachable at the default address below, the app automatically
# falls back to bundled local sample data (see src/utils/apiClient.js).

# Base URL of your deployed FastAPI backend (no trailing slash), e.g.:
#   VITE_API_BASE_URL=https://mplads-ai-api.example.com
# Defaults to http://localhost:8000 if unset.
VITE_API_BASE_URL=http://localhost:8000
